{
  "name": "hexagon---browser",
  "version": "0.3.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "esbuild tests/*.test.ts --bundle --platform=node --packages=external --format=esm --out-extension:.js=.mjs --outdir=.sim-build/tests --log-level=error && node --test \".sim-build/tests/*.test.mjs\"",
    "simulate": "esbuild tools/simulate.ts --bundle --platform=node --format=esm --outfile=.sim-build/simulate.mjs --log-level=error && node .sim-build/simulate.mjs",
    "typecheck:tools": "tsc -p tools/tsconfig.json",
    "relay": "esbuild server/main.ts --bundle --platform=node --format=esm --packages=external --outfile=.sim-build/relay.mjs --log-level=error && node .sim-build/relay.mjs",
    "build:server": "esbuild server/main.ts --bundle --platform=node --format=esm --outfile=dist-server/relay.mjs --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\" --external:bufferutil --external:utf-8-validate --log-level=error",
    "dev:editor": "vite --config vite.author.config.ts",
    "build:editor": "tsc && vite build --config vite.author.config.ts",
    "preview:editor": "vite preview --config vite.author.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-only",
  "description": "",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.27.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "dependencies": {
    "ws": "^8.22.1"
  }
}
